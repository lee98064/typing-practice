  "rules": [
    {
      "title": "大根、書寫順序與補短",
      "body": "優先取筆畫較多的根，原則上由上而下、由左而右、由外而內；眼順優先。只取到一或兩個根時，再補最後一筆或規定形；數目字例外。標準形根最多四根。",
      "examples": [
        {
          "char": "明",
          "code": "due",
          "explain": "日用Day取d，月取u；只有兩根，月末橫取e補短。"
        },
        {
          "char": "休",
          "code": "ptn",
          "explain": "亻用People取p，木用Tree取t；兩根後補木的末捺n。"
        },
        {
          "char": "林",
          "code": "ttn",
          "explain": "左右兩木各取Tree的t；不足三根，補右木末捺n。"
        },
        {
          "char": "仁",
          "code": "pre",
          "explain": "亻p、二r；二在字內不是獨立數字，仍補末橫e。"
        }
      ]
    },
    {
      "title": "截長、簡速、簡碼及容錯分層",
      "body": "超四根取首、二、三、尾。簡速根可參與他字；一二碼簡碼是表定捷徑，不能全部類推。標準碼與容錯碼分開標記。",
      "examples": [
        {
          "char": "機",
          "code": "twwb",
          "explain": "木t、幺w、幺w，跳過中間交叉根，末人b；簡碼另為g。"
        },
        {
          "char": "的",
          "code": "d",
          "explain": "一碼簡碼d，完整標準碼pdna；單獨一碼字不表示的字部件永遠只取d。"
        },
        {
          "char": "俞",
          "code": "ai",
          "explain": "俞是簡速根a，再以末豎鉤i補短；完整標準拆法aur也收於表。"
        },
        {
          "char": "天",
          "code": "edn",
          "explain": "一e、大d再補捺n是官網明示容錯碼；標準應按大根取gnn。"
        }
      ]
    },
    {
      "title": "候選編號不是字根拆解",
      "body": "首候選編號0、空白送首選；第二個為1。V/R/S/F/W/L/C/B依官方對應1至8選；K=9是既有引擎支援，應檢查碰撞而不任意生成。字表已有標準碼時優先。",
      "examples": [
        {
          "char": "精",
          "code": "mhu",
          "explain": "米m、青的上部h、月u；MHU第0候選。"
        },
        {
          "char": "睛",
          "code": "mhuv",
          "explain": "目m、青的上部h、月u與精重碼；末v為選第1候選的輔助碼。"
        },
        {
          "char": "雞",
          "code": "ewdv",
          "explain": "此碼已有雞，不能用它把EWD第1候選岰覆蓋掉；顯示字表實際對應優先。"
        }
      ]
    }
  ],
