  {
    "id": "chu-shi-biao",
    "sources": [
      {
        "page": "前出師表",
        "url": "https://zh.wikisource.org/wiki/%E5%89%8D%E5%87%BA%E5%B8%AB%E8%A1%A8",
        "revision": 12969966,
        "revision_url": "https://zh.wikisource.org/w/index.php?oldid=12969966",
